{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Rr]obinhood.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m trader.guard || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
